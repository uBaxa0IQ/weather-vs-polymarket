DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weather_analyzer
TOMORROW_API_KEY=replace_me
TRACKED_CITIES=tokyo,munich,london,seoul,shanghai,ankara,mexico-city,austin,hong-kong,chengdu,nyc,toronto,singapore,paris,madrid,warsaw,miami,denver,atlanta,chicago
MAX_CITIES=20
SCHEDULER_INTERVAL_SECONDS=3600
TOMORROW_RPS_LIMIT=3
EXTERNAL_API_RETRIES=4
RUN_SCHEDULER_IN_API=false

# Auth (change both values before deploying)
APP_PASSWORD=changeme
JWT_SECRET=changeme-replace-with-32-char-random-string

# Polymarket CLOB trading
# Set these to enable live order placement
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Optional: proxy wallet address (for social/email login wallets)
POLYMARKET_PROXY_ADDRESS=
# Optional: 0 = EOA, 1 = proxy wallet (auto-detected if blank)
POLYMARKET_SIGNATURE_TYPE=
